[package]
name = "{{name}}"
# Version name + build number (`x.y.z+n`), used for both platforms.
version = "0.1.0+1"
edition = "2024"
publish = false

[lib]
# Native library name: lib{{lib_name}}.so (Android) / lib{{lib_name}}.a (iOS).
name = "{{lib_name}}"
crate-type = ["lib", "cdylib", "staticlib"]

[features]
{{platform_features}}
[dependencies]
rux = {{rux_dep}}

[build-dependencies]
rux-build = {{rux_build_dep}}

# Configuration for the `rux` CLI.
[package.metadata.rux]
# Android applicationId + iOS bundle identifier. Override per platform with
# `android-app-id` / `ios-bundle-id` if they differ.
app-id = "{{app_id}}"
{{workspace}}
